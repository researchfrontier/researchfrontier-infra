# Copy to .env (docker compose reads it automatically).

# Postgres credentials for the local db container.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=researchfrontier

# Optional — only needed to run LIVE ingestion (the seed needs neither).
# Free OpenAlex key: https://openalex.org/settings/api
RF_OPENALEX_API_KEY=
# Your contact email for API etiquette (OpenAlex/Crossref polite pool). YOUR email only.
RF_CONTACT_EMAIL=
